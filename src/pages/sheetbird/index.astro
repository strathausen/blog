---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

export const prerender = true;
---

<html lang="en">
  <head>
    <BaseHead
      title="sheetbird"
      description="sheetbird, a thunderbird add-on"
    />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }
      .download {
        display: inline-block;
        margin: 1em 0;
        padding: 0.75rem 1.5rem;
        background: var(--accent);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
      }
      .download:hover {
        background: var(--accent-dark);
      }
      .meta {
        color: rgb(var(--gray));
        font-size: 0.9em;
      }
    </style>
  </head>
  <body>
    <div class="page-wrapper">
      <Header />
      <main>
        <div class="prose">
          <h1>sheetbird</h1>
          <p>a thunderbird add-on.</p>
          <a
            class="download"
            id="download"
            href="/sheetbird/sheetbird-0.1.1.xpi"
            download="sheetbird-0.1.1.xpi"
          >
            download sheetbird 0.1.1
          </a>
          <p class="meta">version 0.1.1 · needs thunderbird 140 or newer</p>
          <h2>install</h2>
          <ol>
            <li>download the file above.</li>
            <li>in thunderbird, open <strong>add-ons and themes</strong>.</li>
            <li>click the gear icon ⚙️ and choose <strong>install add-on from file…</strong></li>
            <li>pick <code>sheetbird-0.1.1.xpi</code>.</li>
          </ol>
        </div>
      </main>
      <Footer />
    </div>
    <script>
      // Firefox offers to install .xpi files instead of saving them, so
      // fetch the file and save it as a plain blob.
      const link = document.getElementById("download") as HTMLAnchorElement;
      link.addEventListener("click", async (event) => {
        event.preventDefault();
        const res = await fetch(link.href);
        const blob = new Blob([await res.blob()], { type: "application/octet-stream" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = link.download;
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      });
    </script>
  </body>
</html>
